---
import Base from '../layouts/Base.astro';

const projects = [
  {
    name: 'Every City in the USA',
    domain: 'everycityintheusa.com',
    href: 'https://www.everycityintheusa.com/',
    description:
      'A sortable U.S. city database with Census V2025 population, growth, density, and cost-of-living fields.',
    image: 'https://www.everycityintheusa.com/og/index.png',
    resources: [
      {
        label: 'Linktree',
        href: 'https://linktr.ee/everycityintheusa',
      },
      {
        label: 'Figma',
        href: 'https://www.figma.com/community/file/1657087669713630519',
      },
      {
        label: 'Cal',
        href: 'https://cal.com/everycityintheusa',
      },
      {
        label: 'GitHub',
        href: 'https://github.com/nmajor/us-city-data',
      },
    ],
  },
  {
    name: 'National Sites Guide',
    domain: 'nationalsitesguide.com',
    href: 'https://www.nationalsitesguide.com/',
    description:
      'Monthly crowd patterns for U.S. national parks and sites, built from official NPS visitor-use data.',
    image: 'https://www.nationalsitesguide.com/og/home.png',
  },
  {
    name: 'Sites That Get Calls',
    domain: 'sitesthatgetcalls.com',
    href: 'https://www.sitesthatgetcalls.com/',
    description:
      'A website generator for local service businesses: paste a Google Business Profile, get a site pointed at phone calls.',
    image: 'https://www.sitesthatgetcalls.com/brand/og-default.png',
    resources: [
      {
        label: 'Figma',
        href: 'https://www.figma.com/community/file/1657027349697559315',
      },
      {
        label: 'Cal',
        href: 'https://cal.com/sitesthatgetcalls',
      },
      {
        label: 'Linktree',
        href: 'https://linktr.ee/sitesthatgetcalls',
      },
      {
        label: 'GitHub',
        href: 'https://github.com/nmajor/local-business-schema-kit',
      },
    ],
  },
  {
    name: 'TangoLango',
    domain: 'tangolango.com',
    href: 'https://www.tangolango.com/',
    description:
      'Language practice for the dialect around you, with native audio, chat practice, and flashcards from real life.',
    image: 'https://www.tangolango.com/og-image.png',
  },
  {
    name: 'Calculator Campus',
    domain: 'calculatorcampus.com',
    href: 'https://www.calculatorcampus.com/',
    description:
      'Free calculators with plain explanations, from mortgage math to BMI to tip splits.',
    image: 'https://www.calculatorcampus.com/og/site.png',
  },
  {
    name: 'VeilBoard',
    domain: 'veilboard.com',
    href: 'https://www.veilboard.com/',
    description:
      'A 60-second visual quiz that turns a wedding mood into six Pinterest-ready boards.',
    image: 'https://www.veilboard.com/og-image.png',
  },
  {
    name: 'SupplierSignal',
    domain: 'suppliersignal.com',
    href: 'https://www.suppliersignal.com/',
    description:
      'Paste an Amazon ASIN and get a ranked Alibaba supplier shortlist with visual matching, factory-vs-trading estimates, and profitability math.',
    image: '/projects/suppliersignal-og.svg',
  },
];
---
<Base
  title="Projects · Nick Major"
  description="Products Nick Major is building and running: small sites, tools, and the marketing experiments he runs on them."
>
  <div class="wrap">
    <header class="phead">
      <span class="eyebrow">Projects</span>
      <h1 class="phead__title">Things I'm building</h1>
      <p class="phead__sub">Small sites, tools, and products I'm building or running now. Each one doubles as a place to test a distribution idea.</p>
    </header>

    <div class="plist">
      {projects.map((project) => (
        <article class="card project">
          <a class="project__imageLink" href={project.href} target="_blank" rel="noopener">
            <img class="project__image" src={project.image} width="420" height="220" loading="lazy" decoding="async" alt="" />
          </a>
          <div class="project__main">
            <h2 class="project__name"><a href={project.href} target="_blank" rel="noopener">{project.name}</a></h2>
            <a class="project__domain" href={project.href} target="_blank" rel="noopener">{project.domain} ↗</a>
            <p class="project__description">{project.description}</p>
            {project.resources && (
              <ul class="project__resources">
                {project.resources.map((resource) => (
                  <li><a href={resource.href} target="_blank" rel="noopener">{resource.label} ↗</a></li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  <style>
    .plist { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
    .project { overflow: hidden; display: flex; flex-direction: column; }
    .project__imageLink { display: block; aspect-ratio: 1.91 / 1; overflow: hidden; border-bottom: 2px solid var(--ink); background: #fff; }
    .project__image { width: 100%; height: 100%; display: block; object-fit: cover; }
    .project__main { padding: 20px 22px 22px; }
    .project__name { margin: 0; font-family: var(--display); font-size: 26px; font-weight: 800; letter-spacing: -.02em; line-height: 1.1; }
    .project__name a, .project__domain, .project__resources a { text-decoration: none; }
    .project__name a:hover, .project__resources a:hover { color: var(--accent); }
    .project__domain { display: inline-block; margin-top: 4px; font-size: 13px; color: var(--muted); }
    .project__description { margin: 10px 0 0; font-size: 15.5px; color: var(--body); }
    .project__resources { list-style: none; padding: 0; margin: 14px 0 0; display: flex; gap: 8px; flex-wrap: wrap; }
    .project__resources a { display: inline-block; border: 1.5px solid var(--ink); border-radius: 999px; padding: 3px 11px; font-size: 13px; font-weight: 600; }
    @media (max-width: 760px) { .plist { grid-template-columns: 1fr; } }
  </style>
</Base>
