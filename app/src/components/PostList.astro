---
// Post rows for /blog/ and /experiments/, with an honest empty state until the
// first post exists.
import type { CollectionEntry } from 'astro:content';
import SubscribeForm from './SubscribeForm.astro';
import { shortDate, readingMinutes } from '../lib/format';

interface Props {
  posts: CollectionEntry<'posts'>[];
  empty: string;
}
const { posts, empty } = Astro.props;
const kindLabel = { writing: 'Writing', experiment: 'Experiment', tools: 'Tools' } as const;
---
{posts.length > 0 ? (
  <div class="rows">
    {posts.map((p) => (
      <a class="row" href={`/blog/${p.id}/`}>
        <span class="row__main">
          <span class="row__title">
            {p.data.status
              ? <span class={`chip chip--${p.data.status}`}>{p.data.status}</span>
              : <span class="chip">{kindLabel[p.data.kind]}</span>}
            {p.data.title}
          </span>
          <span class="row__blurb">{p.data.summary}</span>
        </span>
        <span class="row__meta">{shortDate(p.data.pubDate)} · {readingMinutes(p.body, p.data.readingMinutes)} min</span>
      </a>
    ))}
  </div>
) : (
  <div class="card empty">
    <h2>{empty}</h2>
    <p>Subscribe to Deploy to Humans and it lands in your inbox. Older writing on applied AI and engineering is in the <a href="/archive/">archive</a>.</p>
    <SubscribeForm id="form-empty" source="empty_state" />
  </div>
)}
