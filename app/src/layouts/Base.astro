---
// Shared shell for every page: <head>, the nav, and the footer. Page content goes
// in the slot. Visual system lives in ../styles/site.css (direction B).
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  // Archived pages point canonical at themselves like any other page; this only
  // exists so a page can opt out of indexing if it ever needs to.
  noindex?: boolean;
}
const { title, description, ogImage = '/og/default.png', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.nmajor.com');
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://www.nmajor.com');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fbf7f0" />

    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/nicholas-major.jpg" />
    <link rel="alternate" type="application/rss+xml" title="Nick Major" href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@thenmajor" />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Rybbit analytics (self-hosted, cookieless). Site id 17. -->
    <script is:inline src="https://rybbit.nmajor.net/api/script.js" data-site-id="17" defer></script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav__inner">
        <a href="/" class="nav__mark">nick major<span>.</span></a>
        <nav class="nav__links" aria-label="Primary">
          <a href="/projects/">Projects</a>
          <a href="/archive/">Writing</a>
          <a href="/about/">About</a>
          <a href="/subscribe/" class="pill">Newsletter</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot__inner">
        <div class="foot__brand">
          <a href="/" class="nav__mark">nick major<span>.</span></a>
          <p>Software engineer figuring out distribution.</p>
        </div>
        <nav class="foot__cols" aria-label="Footer">
          <div class="foot__col">
            <span class="foot__h">Site</span>
            <a href="/projects/">Projects</a>
            <a href="/archive/">Writing</a>
            <a href="/about/">About</a>
          </div>
          <div class="foot__col">
            <span class="foot__h">Read</span>
            <a href="/subscribe/">Deploy to Humans</a>
            <a href="/rss.xml">RSS</a>
          </div>
          <div class="foot__col">
            <span class="foot__h">Elsewhere</span>
            <a href="https://x.com/thenmajor" target="_blank" rel="me noopener">X</a>
            <a href="https://www.linkedin.com/in/nmajor" target="_blank" rel="me noopener">LinkedIn</a>
            <a href="https://github.com/nmajor" target="_blank" rel="me noopener">GitHub</a>
            <a href="https://www.instagram.com/thenmajor" target="_blank" rel="me noopener">Instagram</a>
          </div>
        </nav>
        <span class="foot__meta">© 2026 Nick Major · Lisbon</span>
      </div>
    </footer>
  </body>
</html>
