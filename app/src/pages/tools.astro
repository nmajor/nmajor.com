---
// The stack Nick actually uses. Only tools in real, current use go here. If a link
// ever becomes an affiliate or partner link, say so next to it.
import Base from '../layouts/Base.astro';

const groups = [
  {
    name: 'Building',
    color: 'var(--mint)',
    tools: [
      { name: 'Claude Code', href: 'https://www.anthropic.com/claude-code', what: 'Where most of my code gets written now, and where I run my content and research workflows.' },
      { name: 'Codex CLI', href: 'https://github.com/openai/codex', what: 'A second coding agent. I use it for independent reviews of what Claude Code built.' },
      { name: 'Astro', href: 'https://astro.build', what: 'Static sites, including this one. Fast pages, markdown content, no client JavaScript unless I ask for it.' },
      { name: 'mise', href: 'https://mise.jdx.dev', what: 'Pins every tool version per project, so a project from six months ago still builds.' },
    ],
  },
  {
    name: 'Hosting',
    color: 'var(--blue)',
    tools: [
      { name: 'Cloudflare Workers', href: 'https://workers.cloudflare.com', what: 'Hosting for every site I run. Static assets plus a small Worker for forms and redirects.' },
      { name: 'Cloudflare Turnstile', href: 'https://www.cloudflare.com/products/turnstile/', what: 'Spam protection on forms without making people click traffic lights.' },
    ],
  },
  {
    name: 'Marketing and distribution',
    color: 'var(--yellow)',
    tools: [
      { name: 'Buttondown', href: 'https://buttondown.com', what: 'My newsletter. Simple, has a real API, and sends from my own domain.' },
      { name: 'Postiz', href: 'https://postiz.com', what: 'Schedules social posts to LinkedIn, X, Facebook, and Instagram from one API.' },
      { name: 'DataForSEO', href: 'https://dataforseo.com', what: 'Keyword and search-results data for SEO research, priced per request.' },
      { name: 'Exa', href: 'https://exa.ai', what: 'Search built for agents. I use it to find sources and case studies.' },
    ],
  },
  {
    name: 'Measuring',
    color: 'var(--pink)',
    tools: [
      { name: 'Rybbit', href: 'https://rybbit.io', what: 'Self-hosted, cookieless analytics. No cookie banner, and I own the data.' },
      { name: 'Google Search Console', href: 'https://search.google.com/search-console', what: 'What Google actually indexes and which searches show my pages.' },
    ],
  },
];
---
<Base title="Tools I use · Nick Major" description="The stack behind Nick Major's products and marketing experiments: building, hosting, distribution, and measurement tools he actually uses.">
  <div class="wrap">
    <header class="phead">
      <span class="eyebrow">Tools</span>
      <h1 class="phead__title">Tools I use</h1>
      <p class="phead__sub">The stack behind my products and experiments. Everything here is something I'm using right now, with a line on what I use it for.</p>
    </header>
    {groups.map((g) => (
      <section class="group">
        <h2 class="group__h"><i style={`background:${g.color}`}></i>{g.name}</h2>
        <div class="tools">
          {g.tools.map((t) => (
            <a class="card tool" href={t.href} target="_blank" rel="noopener">
              <strong>{t.name} ↗</strong>
              <span>{t.what}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
  <style>
    .group { margin-top: 36px; }
    .group__h { display: flex; align-items: center; gap: 10px; font-family: var(--display); font-size: 26px; font-weight: 800; letter-spacing: -.02em; margin: 0 0 16px; }
    .group__h i { width: 18px; height: 18px; border: 2px solid var(--ink); border-radius: 5px; }
    .tools { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .tool { display: flex; flex-direction: column; gap: 6px; padding: 20px 22px; text-decoration: none; box-shadow: 4px 4px 0 var(--ink); border-radius: 14px; transition: transform .12s ease, box-shadow .12s ease; }
    .tool:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ink); }
    .tool strong { font-size: 18px; }
    .tool span { color: var(--muted); font-size: 15px; }
    @media (max-width: 700px) { .tools { grid-template-columns: 1fr; } }
    @media (prefers-reduced-motion: reduce) { .tool { transition: none; } }
  </style>
</Base>
