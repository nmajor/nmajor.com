---
// Home: direction B ("hub"). Intro + photo, then a tile grid into each section.
import Base from '../layouts/Base.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
---
<Base
  title="Nick Major · Software engineer figuring out distribution"
  description="I'm Nick Major, a software engineer learning distribution in public. I build products with AI, test marketing and growth tactics on them, and share what works and what doesn't."
>
  <div class="wrap">
    <section class="intro">
      <div>
        <span class="eyebrow">Hey, I'm Nick 👋</span>
        <h1 class="intro__h1">Software engineer figuring out <span class="hl">distribution</span>.</h1>
        <p class="intro__p">I can build almost anything. Getting people to use it is the part I'm learning. I test marketing and growth tactics on my own products, mostly with AI doing the grunt work, and share what works and what doesn't.</p>
      </div>
      <img class="intro__face" src="/nicholas-major.jpg" width="220" height="220" alt="Nick Major" />
    </section>

    <section class="tiles" aria-label="Sections">
      <div class="tile tile--nl">
        <div class="tile__n">Deploy to <span>Humans</span></div>
        <p>My weekly newsletter. Shipping is easy. Deploying to humans is the hard part. Each week: the experiment I ran, what happened, and the tools I used.</p>
        <SubscribeForm id="form-home" source="homepage" theme="dark" />
      </div>
      <a class="tile tile--p" href="/projects/">
        <i class="tile__shape" aria-hidden="true"></i>
        <div><div class="tile__n">Things I'm building</div><p>The products I'm shipping right now.</p></div>
        <span class="tile__go">Projects →</span>
      </a>
      <a class="tile tile--m" href="/archive/">
        <i class="tile__shape" aria-hidden="true"></i>
        <div><div class="tile__n">Writing</div><p>Essays on applied AI from my last newsletter, plus older engineering posts.</p></div>
        <span class="tile__go">Read →</span>
      </a>
      <a class="tile tile--b tile--wide" href="/about/">
        <i class="tile__shape" aria-hidden="true"></i>
        <div><div class="tile__n">About me</div><p>Fifteen years of building software, and why I'm working on the other half now.</p></div>
        <span class="tile__go">About →</span>
      </a>
    </section>

  </div>

  <style>
    .intro { display: grid; grid-template-columns: 1fr 220px; gap: 48px; align-items: center; padding: clamp(28px, 5vw, 56px) 0 clamp(36px, 5vw, 56px); }
    .intro__h1 { margin: 18px 0 0; font-family: var(--display); font-size: clamp(42px, 6vw, 64px); line-height: 1.02; font-weight: 800; letter-spacing: -.03em; }
    .intro__p { font-size: clamp(17px, 1.8vw, 19px); color: var(--muted); margin: 20px 0 0; max-width: 600px; }
    .intro__face { width: 220px; height: 220px; border-radius: 50%; object-fit: cover; border: 6px solid #fff; box-shadow: 10px 10px 0 var(--accent); }

    .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .tile {
      position: relative; border-radius: 18px; padding: 26px; min-height: 220px; text-decoration: none; color: var(--ink);
      display: flex; flex-direction: column; justify-content: space-between;
      border: 2px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); transition: transform .12s ease, box-shadow .12s ease;
    }
    a.tile:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--ink); }
    .tile__n { font-family: var(--display); font-weight: 800; font-size: 30px; line-height: 1.05; letter-spacing: -.02em; padding-right: 60px; }
    .tile p { font-size: 15px; margin: 8px 0 0; opacity: .85; padding-right: 56px; }
    .tile__go { font-weight: 600; font-size: 14px; margin-top: 16px; }
    .tile__shape { position: absolute; right: 22px; top: 22px; width: 54px; height: 54px; border: 2px solid var(--ink); border-radius: 12px; background: rgba(255,255,255,.55); transform: rotate(8deg); }
    .tile--m .tile__shape { border-radius: 50%; }
    .tile--p .tile__shape { transform: rotate(45deg); border-radius: 6px; }
    .tile--nl { grid-column: span 2; background: var(--ink); color: #fff; justify-content: flex-start; }
    .tile--nl .tile__n { font-size: 44px; padding-right: 0; }
    .tile--nl .tile__n span { color: var(--yellow); }
    .tile--nl p { padding-right: 0; max-width: 60ch; }
    .tile--wide { grid-column: span 2; }
    .tile--m { background: var(--mint); }
    .tile--p { background: var(--pink); }
    .tile--b { background: var(--blue); }
    @media (prefers-reduced-motion: reduce) { .tile { transition: none; } }


    @media (max-width: 760px) {
      .intro { grid-template-columns: 1fr; gap: 24px; }
      .intro__face { width: 140px; height: 140px; order: -1; box-shadow: 7px 7px 0 var(--accent); }
      .tiles { grid-template-columns: 1fr; }
      .tile--nl, .tile--wide { grid-column: auto; }
      .tile--nl .tile__n { font-size: 34px; }
      .tile { min-height: 0; }
    }
  </style>
</Base>
